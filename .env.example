[TEMPLATE]
# ProxGram Growth worker — environment configuration
# Copy to .env and fill in. NEVER commit .env or *.session files.
#
# ISOLATION NOTE: this repository uses ONLY client (userbot) credentials.
# Main-bot credentials (TELEGRAM_BOT_TOKEN) are intentionally not supported here.

# https://my.telegram.org -> API development tools
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Output of scripts/generate_session.py (full account access — treat like a password)
SESSION_STRING=

# --- Growth behaviour ------------------------------------------------------- #
# Comma-separated target channels (@username, t.me link or -100... id)
GROWTH_TARGET_CHANNELS=@example_news, @markets_daily
# Where to send readers (the main proxy channel)
GROWTH_DESTINATION_CHANNEL=@proxgram

# Max 1 comment per target per cooldown window (seconds) + random jitter
GROWTH_PER_CHANNEL_COOLDOWN=600
GROWTH_PER_CHANNEL_JITTER=120
# Human-like delay before engaging a fresh post (seconds)
GROWTH_DELAY_MIN=5
GROWTH_DELAY_MAX=20
# Account-level rolling cap: max comments per window (seconds)
GROWTH_GLOBAL_WINDOW=3600
GROWTH_GLOBAL_MAX=12
# Exponential backoff for FloodWait / transient errors
GROWTH_BACKOFF_BASE=30
GROWTH_BACKOFF_FACTOR=2.0
GROWTH_BACKOFF_MAX=3600
# Task queue automation (src/core/seeder.py + src/core/worker.py)
# Seconds between worker boot-time and periodic task seeding cycles
SCHEDULER_INTERVAL=3600
# Seeder dedupe: skip targets with a PENDING/COMPLETED task newer than this
GROWTH_SEED_DEDUPE_HOURS=24
# Hard cap (seconds) for every Telethon connection attempt; transports are
# tried in order Abridged -> Full -> Obfuscated until one succeeds
GROWTH_CONNECT_TIMEOUT_SECONDS=20
# RUNNING tasks older than this are treated as orphaned claims and requeued
# (or FAILED after 3 sweeps) by the claim-timeout sweeper
GROWTH_CLAIM_TIMEOUT_MINUTES=10
# Seconds between orphaned-claim sweeps (runs on boot + every interval)
GROWTH_SWEEP_INTERVAL_SECONDS=300
# Persistent state (cooldowns + processed post IDs survive restarts)
GROWTH_STATE_FILE=data/state.json
GROWTH_LOG_LEVEL=INFO
# Log actions without posting (recommended for the first days)
GROWTH_DRY_RUN=0

# --- Phase 1 infrastructure (roadmap: Foundation & Persistence) ------------- #
# Application Settings
APP_NAME=proxgram_growth
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL - SSOT) — defaults aligned with docker-compose.yml
POSTGRES_USER=proxgram
POSTGRES_PASSWORD=proxgram_secret
POSTGRES_DB=proxgram_growth
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://proxgram:proxgram_secret@postgres:5432/proxgram_growth

# Message Broker & Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Rate Limiting & Health
RATE_LIMIT_DELAY_SECONDS=3.0
SESSION_HEALTH_CHECK_INTERVAL=300
