# ProxGram growth worker — environment variables (copy to .env.growth, keep out of git!)
# https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
# Output of scripts/growth_session.py (full account access — treat like a password)
SESSION_STRING=1ApWapzMBu...redacted...

# --- Growth behaviour (also settable in config/growth_worker.json) ---
# Comma-separated target channels (@username, t.me link or -100... id)
GROWTH_TARGET_CHANNELS=@example_news, @markets_daily
# Where to send readers (the main proxy channel)
GROWTH_DESTINATION_CHANNEL=@proxgram
# Max 1 comment per target per cooldown window (seconds) + jitter
GROWTH_PER_CHANNEL_COOLDOWN=600
GROWTH_PER_CHANNEL_JITTER=120
# Human-like delay before engaging a fresh post (seconds)
GROWTH_DELAY_MIN=5
GROWTH_DELAY_MAX=20
# Account-level rolling cap: max comments per window (seconds)
GROWTH_GLOBAL_WINDOW=3600
GROWTH_GLOBAL_MAX=12
# Exponential backoff for FloodWait / transient errors
GROWTH_BACKOFF_BASE=30
GROWTH_BACKOFF_FACTOR=2.0
GROWTH_BACKOFF_MAX=3600
# Cooldowns survive restarts
GROWTH_STATE_FILE=var/growth_state.json
GROWTH_LOG_LEVEL=INFO
# Log actions without posting (great for the first days)
GROWTH_DRY_RUN=0
# Scrub SESSION_STRING / API_HASH from every log line
GROWTH_REDACT_LOGS=1
